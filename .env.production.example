# Copy this file to .env on the server (cp .env.production.example .env) and fill it in.
# Never commit .env, never email it, and never paste its contents into a chat.

# --- your web address (a domain whose DNS points at the server) ---------------------------------------------------
DOMAIN=books.example.com

# --- security -----------------------------------------------------------------------------------------------------
# Any long random text. Generate one with:  openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-value
SESSION_HOURS=12

# --- limits -------------------------------------------------------------------------------------------------------
MAX_UPLOAD_MB=200
MAX_PAGES=1000
MIN_FREE_DISK_MB=2048

# --- OCR ----------------------------------------------------------------------------------------------------------
OCR_DPI=300
OCR_PSM=6
# Set to true only if you build the image with the slower, more accurate "careful" reading method
# (needs about 2 GB more memory: also raise mem_limit in docker-compose.yml).
INSTALL_CAREFUL=false

# --- translation --------------------------------------------------------------------------------------------------
# mock = test mode (placeholders), openai or claude = real translation
TRANSLATION_PROVIDER=mock
TRANSLATION_API_KEY=
# Leave empty for the provider's default model, or name one.
TRANSLATION_MODEL=

# --- email (password-reset links, sign-up notices) ----------------------------------------------------------------
# Gmail: turn on 2-Step Verification, create an App Password (Google Account > Security > App passwords)
# and put it in SMTP_PASSWORD. Leave SMTP_HOST empty to switch email off ("Forgot password" then says to ask the owner).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Address used in emailed links. Defaults to https://DOMAIN.
PUBLIC_URL=
